{
  "name": "react-concurrent-signals",
  "version": "0.0.1",
  "description": "Signal functions backed by concurrent-safe React store snapshots",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "examples/concurrent-safety"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bench": "vitest bench --config vitest.benchmark.config.ts",
    "build": "tsup",
    "build:examples": "npm run build --workspace @react-concurrent-signals/concurrent-safety",
    "check:package": "node scripts/check-package.mjs",
    "deploy:examples": "npm run deploy --workspace @react-concurrent-signals/concurrent-safety",
    "dev:examples": "npm run dev --workspace @react-concurrent-signals/concurrent-safety",
    "prepack": "npm run build && npm run check:package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@stylexjs/stylex": "^0.18.3",
    "@stylexjs/unplugin": "^0.18.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
